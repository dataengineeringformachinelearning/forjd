{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/favicon-96x96.png",
          "/apple-touch-icon.png",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/web-app-manifest-192x192.png",
          "/web-app-manifest-512x512.png",
          "/fonts/inter/InterVariable.woff2",
          "/forjd.svg"
        ]
      }
    },
    {
      "name": "app-runtime",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
