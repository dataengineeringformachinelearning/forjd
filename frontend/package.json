{
  "name": "forjd",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "preflight": "node scripts/dev-preflight.mjs",
    "start": "npm run preflight && ng serve --configuration development",
    "dev": "npm start",
    "start:poll": "npm run preflight && ng serve --configuration development --poll=1000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "clean:cache": "rm -rf .angular/cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p libs/forjd-ui/tsconfig.lib.json --noEmit --pretty false",
    "lint": "npm run format:check && npm run typecheck",
    "test": "ng test --no-watch",
    "test:app": "ng test frontend --no-watch",
    "test:ui": "ng test forjd-ui --no-watch",
    "test:all": "ng test frontend --no-watch && ng test forjd-ui --no-watch",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "storybook": "ng run forjd-ui:storybook",
    "clean:storybook": "rm -rf dist/storybook/forjd-ui storybook-static",
    "build-storybook": "npm run clean:storybook && ng run forjd-ui:build-storybook",
    "chromatic": "npm run build-storybook && chromatic --exit-zero-on-changes --storybook-build-dir dist/storybook/forjd-ui",
    "prebuild": "rm -rf dist/frontend",
    "sync:suite": "node scripts/sync-suite-from-viking.mjs",
    "suite:purity": "node scripts/check-suite-purity.mjs"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/service-worker": "^22.0.8",
    "@sentry/angular": "^10.57.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "rollbar": "^2.26.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/architect": "^0.2200.7",
    "@angular-devkit/core": "^22.0.7",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.8",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/angular-vite": "^10.5.3",
    "chromatic": "^18.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
